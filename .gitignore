# ───────────────────────────────────────────────────────────────
# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Virtual Documents (if generated)
**/.virtual_documents/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# Subproject build & metadata
ISS_preprocessing/build/
ISS_preprocessing/*.egg-info/
ISS_decoding/build/
ISS_decoding/*.egg-info/
ISS_postprocessing/build/
ISS_postprocessing/*.egg-info/

# Python environment directories
env/
venv/
.venv/
ENV/
ENV3/

# IDE / editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# macOS & Windows system files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*~

# Cache directories
.cache/
